node_modules/
dist/
dev-dist/

# Wrangler local state (includes the local D1 sqlite file)
.wrangler/

# Generated by `wrangler types`
worker-configuration.d.ts

# Secrets — never commit. Documented in .env.example.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
# ...but the example must publish: the Deploy to Cloudflare button reads it to know which values to
# prompt a new self-hoster for. It contains names, never values.
!.dev.vars.example

# This installation's real wrangler config: worker name, database id, team domain, audience tag.
# The tracked wrangler.jsonc is the template; this is what deploys.
wrangler.local.jsonc

# Deployment notes and planning docs specific to one installation: worker URLs, team domain,
# Access policy ids, household figures. Useful to keep, never to publish.
docs/private/

# Pre-deploy database dumps written by scripts/db-backup.mjs. These are your actual financial
# records in plain SQL — never commit them anywhere, least of all a public repository.
backups/

# Test output
coverage/
playwright-report/
test-results/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
